# Safe example values only. Copy to .env and replace placeholders locally.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=hrms
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=hrms
PORT=7000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
BYPASS_IP_CHECK=false
